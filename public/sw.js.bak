/* ===== QURBA service worker: offline-first shell, pages, Quran text, fonts =====
   Bump VERSION on every deploy that changes this file. */
const VERSION = 'v1';
const SHELL = `qurba-shell-${VERSION}`;
const RUNTIME = `qurba-runtime-${VERSION}`;
const PAGES = 'qurba-pages'; // kept across versions so downloaded Quran stays offline

self.addEventListener('install', (e) => {
  e.waitUntil(caches.open(SHELL)
    .then((c) => c.addAll(['/', '/manifest.webmanifest', '/brand/qurba-icon-192.png', '/brand/qurba-logo.png']))
    .then(() => self.skipWaiting()));
});

self.addEventListener('activate', (e) => {
  e.waitUntil(caches.keys()
    .then((keys) => Promise.all(keys.filter((k) => k.startsWith('qurba-') && ![SHELL, RUNTIME, PAGES].includes(k)).map((k) => caches.delete(k))))
    .then(() => self.clients.claim()));
});

const inertiaKey = (url) => `${url.origin}${url.pathname}${url.search}${url.search ? '&' : '?'}__inertia=1`;

async function cacheFirst(req, name) {
  const hit = await caches.match(req);
  if (hit) return hit;
  const res = await fetch(req);
  if (res.ok || res.type === 'opaque') (await caches.open(name)).put(req, res.clone());
  return res;
}

async function staleWhileRevalidate(req, name) {
  const cache = await caches.open(name);
  const hit = await cache.match(req);
  const net = fetch(req).then((res) => { if (res.ok) cache.put(req, res.clone()); return res; }).catch(() => hit);
  return hit || net;
}

async function inertia(req, url) {
  const cache = await caches.open(PAGES);
  try {
    const res = await fetch(req);
    if (res.ok && res.headers.get('X-Inertia')) cache.put(inertiaKey(url), res.clone());
    return res;
  } catch {
    const hit = await cache.match(inertiaKey(url));
    return hit || Response.error();
  }
}

async function navigate(req, url) {
  const cache = await caches.open(PAGES);
  try {
    const res = await fetch(req);
    if (res.ok) { cache.put(req.url, res.clone()); if (url.pathname === '/') (await caches.open(SHELL)).put('/', res.clone()); }
    return res;
  } catch {
    const page = await cache.match(req.url);
    if (page) return page;
    // Rebuild the page from the app shell + the cached Inertia JSON for this URL
    const shell = await caches.match('/');
    const data = await cache.match(inertiaKey(url));
    if (shell && data) {
      const html = await shell.text();
      const json = (await data.text()).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      const out = html.replace(/data-page="[^"]*"/, `data-page="${json}"`);
      return new Response(out, { headers: { 'Content-Type': 'text/html; charset=utf-8' } });
    }
    return shell || Response.error();
  }
}

self.addEventListener('fetch', (e) => {
  const req = e.request;
  if (req.method !== 'GET') return;
  const url = new URL(req.url);

  if (url.origin === self.location.origin) {
    if (url.pathname.startsWith('/build/') || url.pathname.startsWith('/brand/')) return e.respondWith(cacheFirst(req, RUNTIME));
    if (url.pathname.startsWith('/api/v1/quran/')) return e.respondWith(staleWhileRevalidate(req, PAGES));
    if (url.pathname.startsWith('/api/') || url.pathname.startsWith('/admin')) return; // live only
    if (req.headers.get('X-Inertia')) return e.respondWith(inertia(req, url));
    if (req.mode === 'navigate') return e.respondWith(navigate(req, url));
    return;
  }
  if (url.hostname === 'fonts.googleapis.com' || url.hostname === 'fonts.gstatic.com') return e.respondWith(cacheFirst(req, RUNTIME));
  // Everything else (e.g. reciter audio) goes straight to the network: no caching without licence.
});
