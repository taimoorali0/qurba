<!-- ===== QURBA: Surah list ===== -->
<script setup lang="ts">
import { Head, Link } from '@inertiajs/vue3';
import { computed, ref, onMounted } from 'vue';
import { useI18n } from 'vue-i18n';
import { Search } from 'lucide-vue-next';
import QurbaShell from '../layouts/QurbaShell.vue';
import { getLastRead, type LastRead } from '../lib/quranLocal';

interface Surah { id: number; name_simple: string; name_arabic: string | null; name_english: string | null; revelation_place: string | null; ayah_count: number }
const props = defineProps<{ surahs: Surah[] }>();
const { t } = useI18n();

const q = ref('');
const lastRead = ref<LastRead | null>(null);
onMounted(() => { lastRead.value = getLastRead(); });

const norm = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
const filtered = computed(() => {
  const term = norm(q.value);
  if (!term) return props.surahs;
  return props.surahs.filter((s) => String(s.id) === q.value.trim() || norm(s.name_simple).includes(term)
    || (s.name_english && norm(s.name_english).includes(term)) || (s.name_arabic && s.name_arabic.includes(q.value.trim())));
});
</script>

<template>
  <Head :title="t('nav.quran')" />
  <QurbaShell>
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <h1 class="font-display text-3xl text-emerald-900 md:text-4xl">{{ t('nav.quran') }}</h1>
      <label class="relative block md:w-80">
        <Search class="pointer-events-none absolute start-4 top-1/2 size-4 -translate-y-1/2 text-ink-soft" />
        <input v-model="q" type="search" :placeholder="t('quran.searchSurah')"
          class="w-full rounded-full border border-line bg-paper py-2.5 pe-4 ps-11 text-sm focus:border-gold-500 focus:ring-0" />
      </label>
    </div>

    <Link v-if="lastRead" :href="`/quran/${lastRead.surah}#ayah-${lastRead.ayah}`"
      class="mt-6 flex items-center justify-between rounded-[var(--radius-sheet)] bg-emerald-900 px-6 py-5 text-cream">
      <span>
        <span class="block text-sm text-gold-200">{{ t('home.continue') }}</span>
        <span class="mt-1 block font-display text-xl">{{ lastRead.name }}</span>
      </span>
      <span class="rounded-full bg-gold-500 px-4 py-1.5 text-sm text-emerald-950">{{ t('quran.ayah') }} {{ lastRead.ayah }}</span>
    </Link>

    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <li v-for="s in filtered" :key="s.id">
        <Link :href="`/quran/${s.id}`"
          class="flex items-center gap-4 rounded-[var(--radius-tile)] border border-line bg-paper px-4 py-3.5 transition-colors hover:border-gold-500">
          <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-emerald-100 text-sm font-medium text-emerald-900">{{ s.id }}</span>
          <span class="min-w-0 flex-1">
            <span class="block truncate font-medium text-ink">{{ s.name_simple }}</span>
            <span class="block truncate text-xs text-ink-soft">
              <template v-if="s.revelation_place">{{ t('quran.' + s.revelation_place) }} | </template>{{ s.ayah_count }} {{ t('quran.ayahs') }}
            </span>
          </span>
          <span v-if="s.name_arabic" dir="rtl" lang="ar" class="font-quran text-xl text-emerald-900">{{ s.name_arabic }}</span>
        </Link>
      </li>
    </ul>
    <p v-if="!filtered.length" class="mt-10 text-center text-ink-soft">{{ t('quran.noMatch') }}</p>
  </QurbaShell>
</template>
